// AHD Radio DJ – Prisma schema
// All table + column names are snake_case in Postgres; Prisma client fields stay camelCase.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("PG_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  role      String   @default("user") // admin | user
  createdAt DateTime @default(now()) @map("created_at")

  @@map("users")
}

model Device {
  id        String   @id @default(uuid())
  serial    String   @unique
  hostname  String
  ip        String?
  mac       String?
  model     String?
  zoneId    String?  @map("zone_id")
  zone      Zone?    @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  status    String   @default("offline") // online | offline | unassigned
  lastSeen  DateTime @default(now()) @map("last_seen")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([status])
  @@index([zoneId])
  @@map("devices")
}

model Zone {
  id            String   @id @default(uuid())
  name          String   @unique
  defaultSource String   @default("radio") @map("default_source")
  streamUrl     String?  @map("stream_url")
  volume        Int      @default(80)
  devices       Device[]
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("zones")
}

// Audio lives in the existing database; local files are a disposable playback cache.
model RadioAsset {
  id        String   @id @default(uuid())
  key       String   @unique
  kind      String
  title     String
  audio     Bytes
  duration  Float
  script    String?
  metadata  Json?
  slot      DateTime?
  createdAt DateTime @default(now()) @map("created_at")
  playbacks RadioPlayback[]

  @@index([kind, slot])
  @@map("radio_assets")
}

model RadioPlayback {
  id           String    @id @default(uuid())
  assetId      String?   @map("asset_id")
  asset        RadioAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)
  title        String
  language     String    @default("de")
  kind         String
  startedAt    DateTime  @default(now()) @map("started_at")
  endedAt      DateTime? @map("ended_at")
  status       String    @default("playing")
  scheduledFor DateTime? @map("scheduled_for")
  repeated     Boolean   @default(false)
  listeners    Int       @default(0)
  error        String?

  @@index([startedAt])
  @@index([assetId])
  @@map("radio_playbacks")
}

model RadioJob {
  key        String   @id
  status     String   @default("pending")
  attempts   Int      @default(0)
  leaseUntil DateTime? @map("lease_until")
  error      String?
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("radio_jobs")
}
